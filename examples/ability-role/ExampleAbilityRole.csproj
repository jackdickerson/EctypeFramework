<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>ExampleAbilityRole</AssemblyName>
    <RootNamespace>ExampleAbilityRole</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="EctypeFramework" HintPath="$(PluginsDir)\EctypeFramework.dll" Private="false" />
    <Reference Include="Assembly-CSharp" HintPath="$(ManagedDir)\Assembly-CSharp.dll" Private="false" />
    <Reference Include="Opsive.UltimateCharacterController" HintPath="$(ManagedDir)\Opsive.UltimateCharacterController.dll" Private="false" />
    <Reference Include="PhotonUnityNetworking" HintPath="$(ManagedDir)\PhotonUnityNetworking.dll" Private="false" />
    <Reference Include="Opsive.Shared" HintPath="$(ManagedDir)\Opsive.Shared.dll" Private="false" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="src\*.cs" />
    <!-- A resource whose name ends "ectype-role.json" is how the framework finds this assembly as a role mod. -->
    <EmbeddedResource Include="manifest\*.json" />
  </ItemGroup>

</Project>
