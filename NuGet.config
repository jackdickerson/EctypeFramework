<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    The build restores one package, Microsoft.NETFramework.ReferenceAssemblies, from
    nuget.org. <clear /> makes restore independent of the machine-wide NuGet config, which
    may list no sources at all and then fails with NU1100.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
