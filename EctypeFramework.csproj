<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>EctypeFramework</AssemblyName>
    <RootNamespace>Ectype</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <!-- The framework loads without VoidManager: src\shared files leave out their
         VoidManager-typed members, and no compiled type names a VoidManager type.
         Directory.Build.props references VoidManager.dll in a dev tools build only, for
         MenuKit's debug-mode read, which runs only inside VoidManager's own F5 menu. It is
         never copied: every reference is Private=false. -->
    <DefineConstants>$(DefineConstants);VOIDMANAGER_OPTIONAL</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="src\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="assets\placeholder-square.png" LogicalName="Ectype.placeholder-square.png" />
    <EmbeddedResource Include="assets\placeholder-wide.png" LogicalName="Ectype.placeholder-wide.png" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="src\shared\ModFlagPolicy.cs" />
    <Compile Include="src\shared\Refl.cs" />
    <Compile Include="src\shared\kitbash\KitbashCore.cs" />
    <Compile Include="src\shared\kitbash\KitbashRecipe.cs" />
  </ItemGroup>

  <!-- Dev tools, compiled only with -p:DevTools=true (Directory.Build.props defines
       ECTYPE_DEV for the code that calls into them). Never shipped. -->
  <ItemGroup Condition="'$(DevTools)' == 'true'">
    <Compile Include="src\dev\*.cs" />
    <Compile Include="src\shared\MenuKit.cs" />
    <Compile Include="src\shared\devkeys\DevKeyGate.cs" />
  </ItemGroup>

</Project>
